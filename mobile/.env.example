# MatchRV mobile environment. Copy to .env.local and fill in. Never commit real values.
# EXPO_PUBLIC_* values are inlined into the JS bundle (they are client config, not secrets),
# but keep them out of git anyway so each environment can be configured separately.

# MatchRV MCP endpoint (defaults to https://matchrv.com/mcp when blank)
EXPO_PUBLIC_MCP_URL=

# Firebase web app config (Firebase console > Project settings > Your apps > Web app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Named Firestore database id used by the existing firestore.rules deployment
# (see firebase.json at the repo root for the value the Kotlin app uses)
EXPO_PUBLIC_FIRESTORE_DATABASE_ID=

# Google OAuth client IDs (Google Cloud console > APIs & Services > Credentials)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Gemini model for Ask AI via Firebase AI Logic (defaults to the Kotlin app's model when blank)
EXPO_PUBLIC_GEMINI_MODEL=

# Optional native Firebase config file paths (build-time only, gitignored files)
GOOGLE_SERVICES_JSON=
GOOGLE_SERVICE_INFO_PLIST=
